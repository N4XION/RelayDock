root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,cpp,h,hpp,in}]
indent_style = tab
indent_size = 8

[{CMakeLists.txt,*.cmake}]
indent_style = space
indent_size = 2

[*.{json,yml,yaml,md,ini,qrc,svg}]
indent_style = space
indent_size = 2

[*.{ps1,iss}]
indent_style = space
indent_size = 4

[*.{bat,cmd,iss}]
end_of_line = crlf
