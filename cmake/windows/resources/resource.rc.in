1 VERSIONINFO
 FILEVERSION ${PROJECT_VERSION_MAJOR},${PROJECT_VERSION_MINOR},${PROJECT_VERSION_PATCH},${PLUGIN_BUILD_NUMBER}
 PRODUCTVERSION ${PROJECT_VERSION_MAJOR},${PROJECT_VERSION_MINOR},${PROJECT_VERSION_PATCH},${PLUGIN_BUILD_NUMBER}
 FILEFLAGSMASK 0x0L
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x0L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "${PLUGIN_AUTHOR}"
            VALUE "FileDescription", "${PLUGIN_DISPLAY_NAME} multistream plugin for OBS Studio"
            VALUE "FileVersion", "${PLUGIN_VERSION_FULL}"
            VALUE "InternalName", "${PROJECT_NAME}"
            VALUE "LegalCopyright", "(C) ${CURRENT_YEAR} ${PLUGIN_AUTHOR}. GPL-2.0-or-later."
            VALUE "OriginalFilename", "${PROJECT_NAME}.dll"
            VALUE "ProductName", "${PLUGIN_DISPLAY_NAME}"
            VALUE "ProductVersion", "${PLUGIN_VERSION_FULL}"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
